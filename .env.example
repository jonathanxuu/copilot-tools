PORT=8787
# Production: https://copilot-mcp.zkid.xyz
# Local development: http://127.0.0.1:8787
MCP_PUBLIC_ORIGIN=https://copilot-mcp.zkid.xyz
# Browser OAuth must use the same public origin as MCP_PUBLIC_ORIGIN.
MCP_BROWSER_ORIGIN=https://copilot-mcp.zkid.xyz

# Microsoft Graph adapter settings.
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
MICROSOFT_GRAPH_API_VERSION=beta

# Optional shared-secret protection between this server and an MCP client.
# Prefer the standard OAuth flow in production.
MCP_SHARED_BEARER_TOKEN=

# Standard MCP OAuth / Microsoft MSAL settings.
# Use the Entra tenant ID and app registration client ID.
M365_MCP_TENANT_ID=
M365_MCP_ENTRA_CLIENT_ID=
# Optional: restrict the connector to one known work account.
M365_MCP_ALLOWED_USERNAME=
# MCP clients must use callback URLs listed here. Use comma-separated values.
M365_MCP_REDIRECT_URIS=http://127.0.0.1:3000/oauth/callback,http://localhost:3000/oauth/callback
# Stable MCP client ID; keep this unchanged across server restarts.
M365_MCP_OAUTH_CLIENT_ID=microsoft-copilot-mcp
M365_MCP_TIME_ZONE=Asia/Shanghai
# Use device-code for a remote server. Loopback is only for local testing.
M365_MCP_LOGIN_MODE=device-code
M365_MCP_LOOPBACK_PORT=8788
M365_MCP_EXPIRES_AT=2099-01-01T00:00:00Z
M365_MCP_TOKEN_CACHE_PATH=./data/msal-cache.enc
M365_MCP_TOKEN_CACHE_KEY=replace-with-a-secret-used-to-encrypt-msal-cache
# Permission-restricted local mapping for Copilot conversation handles and
# successful real-time Copilot activity.
M365_MCP_CONVERSATION_STATE_PATH=./data/conversations.json
# Pages scopes are intentionally omitted while Copilot Pages tools are disabled.
M365_MCP_GRAPH_SCOPES=User.Read,Sites.Read.All,Mail.Read,People.Read.All,OnlineMeetingTranscript.Read.All,Chat.Read,ChannelMessage.Read.All,ExternalItem.Read.All,openid,profile,offline_access
M365_MCP_MAX_GRAPH_REQUESTS=12
M365_MCP_MAX_PAGE_BYTES=2097152

# Set enterprise for Microsoft 365 Copilot API testing. Personal accounts can
# authenticate but are not supported by the enterprise Copilot API routes.
MICROSOFT_ACCOUNT_MODE=enterprise

# Optional enterprise Copilot Interaction Export. Disabled by default.
# Requires an Entra certificate, application permission
# AiEnterpriseInteraction.Read.All, and admin consent.
M365_MCP_HISTORY_ENABLED=false
M365_MCP_HISTORY_PRIVATE_KEY_PATH=
M365_MCP_HISTORY_CERT_THUMBPRINT_SHA256=
# Default query window; user requests may choose another range within 5 years.
M365_MCP_HISTORY_DEFAULT_DAYS=30
M365_MCP_HISTORY_MAX_REQUESTS=10
# Optional comma-separated allowlist of Copilot session IDs.
M365_MCP_HISTORY_ALLOWED_SESSION_IDS=
